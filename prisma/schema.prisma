generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  operador
  lector
}

enum DispatchState {
  pendiente
  parcial
  despachado
  cambio
}

enum DispatchSource {
  programa
  excel
  manual
}

model Profile {
  id                 String   @id @default(uuid())
  email              String   @unique
  fullName           String
  role               Role     @default(lector)
  area               String?
  position           String?
  passwordHash       String?
  mustChangePassword Boolean  @default(false)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  events DispatchEvent[]
  reports ReportDelivery[]
  presence UserPresence?
  auditLogs AuditLog[]

  @@index([role])
  @@index([active])
}

model UserPresence {
  id           String   @id @default(uuid())
  profileId    String   @unique
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  email        String
  fullName     String
  role         Role
  lastSeenAt   DateTime @default(now())
  lastActivity String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lastSeenAt])
  @@index([role])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actor       Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String
  action      String
  entity      String
  entityId    String?
  summary     String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([actorEmail])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

enum ReportDeliveryStatus {
  enviado
  error
}

model Program {
  id          String     @id @default(uuid())
  name        String
  builder     String
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  dispatches  Dispatch[]

  @@index([active])
  @@index([createdAt])
}

model Dispatch {
  id          String         @id @default(uuid())
  legacyId    Int?
  programId   String
  program     Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  businessLine String         @default("Constructora")
  project     String
  projectType String          @default("Edificio")
  type        String
  description String?
  detail      String?
  tower       String?
  core        String?
  floor       String?
  fabricationType String       @default("RTA")
  productionStage String       @default("Corte")
  productionStartAt DateTime?
  units       Int            @default(0)
  scheduledAt DateTime
  source      DispatchSource @default(programa)
  sortOrder   Int            @default(0)
  parentDispatchId String?
  parentDispatch   Dispatch?  @relation("DispatchCompletion", fields: [parentDispatchId], references: [id], onDelete: SetNull)
  completionTasks  Dispatch[] @relation("DispatchCompletion")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  status      DispatchStatus?
  events      DispatchEvent[]

  @@index([programId, businessLine])
  @@index([programId, projectType])
  @@index([programId, productionStage])
  @@index([productionStartAt])
  @@index([programId, project])
  @@index([parentDispatchId])
  @@index([scheduledAt])
  @@unique([programId, legacyId])
}

model DispatchStatus {
  dispatchId String        @id
  dispatch   Dispatch      @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  state      DispatchState @default(pendiente)
  actualAt   DateTime?
  notes      String?
  updatedBy  String?
  updatedAt  DateTime      @updatedAt
  createdAt  DateTime      @default(now())
}

model DispatchEvent {
  id         String        @id @default(uuid())
  dispatchId String
  dispatch   Dispatch      @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  state      DispatchState
  actualAt   DateTime?
  notes      String?
  actorId    String?
  actor      Profile?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())

  @@index([dispatchId, createdAt])
}

model ReportDelivery {
  id          String               @id @default(uuid())
  reportDate  DateTime
  senderEmail String
  senderId    String?
  sender      Profile?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  recipients  String[]
  projects    String[]
  fileName    String
  filePath    String
  status      ReportDeliveryStatus
  error       String?
  createdAt   DateTime             @default(now())

  @@index([reportDate])
  @@index([createdAt])
  @@index([status])
}
